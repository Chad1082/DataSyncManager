@model List<DataSyncManager.Web.Models.Project>
@{
    ViewData["Title"] = "Projects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-folder2-open me-2 text-primary"></i>Projects</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Project</a>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-folder2-open fs-1 mb-3 d-block"></i>
        <p>No projects configured yet.</p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-outline-primary">Create your first project</a>
        }
    </div>
}
else
{
    <div class="row g-3">
    @foreach (var p in Model)
    {
        var lastRun = p.ProjectRuns.OrderByDescending(r => r.StartedAt).FirstOrDefault();
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">
                            <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">@p.Name</a>
                        </h5>
                        @if (!p.IsActive)
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                        else if (p.IsScheduled)
                        {
                            <span class="badge bg-info"><i class="bi bi-clock me-1"></i>Scheduled</span>
                        }
                    </div>

                    <p class="text-muted small mb-3">@(p.Description ?? "No description")</p>

                    <div class="row text-center g-2 mb-3">
                        <div class="col-4">
                            <div class="bg-light rounded p-2">
                                <div class="fw-bold">@p.Jobs.Count(j => j.IsActive)</div>
                                <div class="text-muted" style="font-size:.7rem;">Jobs</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-light rounded p-2">
                                <div class="fw-bold">@p.SourceServer.Name</div>
                                <div class="text-muted" style="font-size:.7rem;">Source</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-light rounded p-2">
                                @if (lastRun != null)
                                {
                                    @Html.Partial("_StatusBadge", lastRun.Status)
                                }
                                else
                                {
                                    <span class="text-muted small">Never run</span>
                                }
                                <div class="text-muted" style="font-size:.7rem;">Last Run</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                            <i class="bi bi-eye me-1"></i>View
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="RunNow" asp-route-id="@p.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-success" title="Run now">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}
