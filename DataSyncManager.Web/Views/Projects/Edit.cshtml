@model ProjectFormViewModel
@{
    ViewData["Title"] = "Edit Project";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
            <div>
                <h2 class="mb-0">Edit Project</h2>
                <p class="text-muted mb-0">@Model.Name</p>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-info-circle me-2"></i>Project Details</div>
                <div class="card-body row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold">Project Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SourceServerId" class="form-label fw-semibold">Source Server</label>
                        <select asp-for="SourceServerId" asp-items="Model.SourceServerSelectList"
                                class="form-select" disabled>
                            <option value="">-- Select Source --</option>
                        </select>
                        <input type="hidden" asp-for="SourceServerId" />
                        <div class="form-text text-warning">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Source server cannot be changed after jobs have been created.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-clock me-2"></i>Schedule</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsScheduled" class="form-check-input" type="checkbox" id="enableSchedule" />
                        <label class="form-check-label fw-semibold" for="enableSchedule">Enable scheduled runs</label>
                    </div>
                    <div id="cronPanel" class="@(Model.IsScheduled ? "" : "d-none")">
                        @await Html.PartialAsync("_CronBuilder", Model.CronExpression ?? "")
                        <div class="mb-3 mt-3">
                            <label asp-for="ScheduleTimezone" class="form-label fw-semibold">Timezone</label>
                            <select asp-for="ScheduleTimezone" asp-items="Model.AvailableTimezones" class="form-select"></select>
                            <div class="form-text">Cron times are interpreted in this timezone. Use <strong>GMT Standard Time</strong> for UK time (handles BST automatically).</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-bell me-2"></i>Email Alerts</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alert on</label>
                        <select asp-for="ProjectAlertOn" class="form-select">
                            <option value="0">Never</option>
                            <option value="1">Succeeded only</option>
                            <option value="2">Failed only</option>
                            <option value="4">Errors / partial only</option>
                            <option value="7">Always (all outcomes)</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="AlertEmailAddresses" class="form-label fw-semibold">Alert Email Addresses</label>
                        <input asp-for="AlertEmailAddresses" class="form-control"
                               placeholder="ops@example.com, team@example.com" />
                        <div class="form-text">Comma-separated list of recipients.</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('enableSchedule').addEventListener('change', function() {
            document.getElementById('cronPanel').classList.toggle('d-none', !this.checked);
            if (!this.checked) document.getElementById('cbHidden').value = '';
        });
    </script>
}
