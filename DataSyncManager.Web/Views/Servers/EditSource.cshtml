@model SourceServerViewModel
@{
    ViewData["Title"] = "Edit Source Server";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Sources" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
            <div>
                <h2 class="mb-0">Edit Source Server</h2>
                <p class="text-muted mb-0">@Model.Name</p>
            </div>
        </div>

        <form asp-action="EditSource" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SourceType" />

            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-info-circle me-2"></i>General</div>
                <div class="card-body row g-3">
                    <div class="col-md-7">
                        <label asp-for="Name" class="form-label fw-semibold">Server Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Source Type</label>
                        <input value="@Model.SourceType" class="form-control" readonly />
                        <div class="form-text">Source type cannot be changed after creation.</div>
                    </div>
                </div>
            </div>

            @if (Model.SourceType == DataSyncManager.Web.Models.SourceType.SqlServer)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-semibold"><i class="bi bi-server me-2"></i>Connection</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="ServerAddress" class="form-label fw-semibold">Server Address <span class="text-danger">*</span></label>
                            <input asp-for="ServerAddress" class="form-control" placeholder="e.g. localhost\SQLEXPRESS  or  192.168.1.10" />
                            <span asp-validation-for="ServerAddress" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Authentication</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="UseWindowsAuth" id="srcAuthWindows"
                                           value="true" @(Model.UseWindowsAuth ? "checked" : "") />
                                    <label class="form-check-label" for="srcAuthWindows">Windows Authentication</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="UseWindowsAuth" id="srcAuthSql"
                                           value="false" @(!Model.UseWindowsAuth ? "checked" : "") />
                                    <label class="form-check-label" for="srcAuthSql">SQL Server Authentication</label>
                                </div>
                            </div>
                        </div>

                        <div id="srcSqlAuthPanel" class="@(Model.UseWindowsAuth ? "d-none" : "") mb-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="SqlUsername" class="form-label fw-semibold">Username</label>
                                    <input asp-for="SqlUsername" class="form-control" placeholder="sa" autocomplete="username" />
                                    <span asp-validation-for="SqlUsername" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="SqlPassword" class="form-label fw-semibold">Password</label>
                                    <input asp-for="SqlPassword" class="form-control" type="password" autocomplete="current-password" />
                                    <div class="form-text">Leave blank to keep the existing password.</div>
                                    <span asp-validation-for="SqlPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Database <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <select id="srcDatabaseSelect" class="form-select">
                                    @if (!string.IsNullOrEmpty(Model.DefaultDatabase))
                                    {
                                        <option value="@Model.DefaultDatabase" selected>@Model.DefaultDatabase</option>
                                    }
                                    else
                                    {
                                        <option value="">— enter server details, then click Load —</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-secondary" id="srcLoadDbsBtn">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Load
                                </button>
                            </div>
                            <input asp-for="DefaultDatabase" type="hidden" id="srcDefaultDatabaseHidden" />
                            <span asp-validation-for="DefaultDatabase" class="text-danger small"></span>
                        </div>

                        <div class="mb-1">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="srcTestConnBtn">
                                <i class="bi bi-plug me-1"></i>Test Connection
                            </button>
                            <span id="srcTestConnResult" class="ms-2 small"></span>
                        </div>
                    </div>
                </div>
            }
            else if (Model.SourceType == DataSyncManager.Web.Models.SourceType.Odbc)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-semibold"><i class="bi bi-plug me-2"></i>Connection</div>
                    <div class="card-body">
                        <label asp-for="ConnectionString" class="form-label fw-semibold">Connection String <span class="text-danger">*</span></label>
                        <textarea asp-for="ConnectionString" class="form-control font-monospace" rows="3"></textarea>
                        <span asp-validation-for="ConnectionString" class="text-danger small"></span>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-semibold"><i class="bi bi-cloud me-2"></i>REST API</div>
                    <div class="card-body row g-3">
                        <div class="col-12">
                            <label asp-for="BaseUrl" class="form-label fw-semibold">Base URL</label>
                            <input asp-for="BaseUrl" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="AuthHeader" class="form-label fw-semibold">Auth Header</label>
                            <input asp-for="AuthHeader" class="form-control" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.SourceType == DataSyncManager.Web.Models.SourceType.Odbc)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-semibold"><i class="bi bi-calendar-date me-2"></i>ODBC Options</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="SourceDateFormat" class="form-label fw-semibold">Date Filter Format</label>
                                <input asp-for="SourceDateFormat" class="form-control font-monospace" id="sourceDateFormatInput"
                                       placeholder="yyyy-MM-dd HH:mm:ss" />
                                <div class="form-text">
                                    Format used when building date range filters in ODBC queries.
                                    Uses .NET <a href="https://learn.microsoft.com/en-us/dotnet/standard/base-types/custom-date-and-time-format-strings" target="_blank" rel="noopener">custom date/time format strings</a>.
                                </div>
                                <span asp-validation-for="SourceDateFormat" class="text-danger small"></span>
                                <div class="mt-2 d-flex flex-wrap gap-2">
                                    <span class="text-muted small me-1 align-self-center">Common formats:</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary font-monospace" onclick="setDateFmt('yyyy-MM-dd HH:mm:ss')">yyyy-MM-dd HH:mm:ss</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary font-monospace" onclick="setDateFmt('yyyy-MM-ddTHH:mm:ss')">yyyy-MM-ddTHH:mm:ss</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary font-monospace" onclick="setDateFmt('MM/dd/yyyy HH:mm:ss')">MM/dd/yyyy HH:mm:ss</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary font-monospace" onclick="setDateFmt('dd/MM/yyyy HH:mm:ss')">dd/MM/yyyy HH:mm:ss</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary font-monospace" onclick="setDateFmt('yyyy-MM-dd')">yyyy-MM-dd</button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="OdbcCommandTimeout" class="form-label fw-semibold">Command Timeout (seconds)</label>
                                <input asp-for="OdbcCommandTimeout" class="form-control" type="number" min="0" max="3600" />
                                <div class="form-text">0 = no timeout (driver default). Increase if queries time out.</div>
                                <span asp-validation-for="OdbcCommandTimeout" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold">
                    <i class="bi bi-globe me-2"></i>Source Data Timezone
                </div>
                <div class="card-body">
                    <label asp-for="SourceTimeZone" class="form-label fw-semibold">Timezone of the Change Date Field</label>
                    <select asp-for="SourceTimeZone" asp-items="Model.AvailableTimezones" class="form-select"></select>
                    <div class="form-text">
                        The timezone that this source stores its change-date values in. Upsert sync windows are
                        calculated in UTC and converted to this zone before filtering. Use
                        <strong>GMT Standard Time</strong> for UK local time (handles BST automatically), or
                        <strong>UTC</strong> if the source already stores UTC. Getting this wrong causes the most
                        recent rows to be missed on every run.
                    </div>
                    <span asp-validation-for="SourceTimeZone" class="text-danger small"></span>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-arrow-repeat me-2"></i>Retry Settings</div>
                <div class="card-body row g-3">
                    <div class="col-md-4">
                        <label asp-for="RetryCount" class="form-label fw-semibold">Retry Attempts</label>
                        <input asp-for="RetryCount" class="form-control" type="number" min="0" max="10" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RetryDelaySeconds" class="form-label fw-semibold">Delay (seconds)</label>
                        <input asp-for="RetryDelaySeconds" class="form-control" type="number" min="1" max="300" />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Sources" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i> Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    @if (Model.SourceType == DataSyncManager.Web.Models.SourceType.Odbc)
    {
        <script>
            window.setDateFmt = function(fmt) {
                document.getElementById('sourceDateFormatInput').value = fmt;
            };
        </script>
    }

    @if (Model.SourceType == DataSyncManager.Web.Models.SourceType.SqlServer)
    {
        <script>
        document.querySelectorAll('input[name="UseWindowsAuth"]').forEach(r =>
            r.addEventListener('change', function () {
                document.getElementById('srcSqlAuthPanel').classList.toggle('d-none', this.value === 'true');
            })
        );

        function srcGetProbePayload(includeDb) {
            const server    = document.getElementById('ServerAddress').value.trim();
            const useWin    = document.querySelector('input[name="UseWindowsAuth"]:checked').value === 'true';
            const username  = document.getElementById('SqlUsername')?.value?.trim() || null;
            const password  = document.getElementById('SqlPassword')?.value || null;
            const database  = includeDb ? (document.getElementById('srcDefaultDatabaseHidden').value || null) : null;
            return { server, useWindowsAuth: useWin, username, password, database };
        }

        async function srcPostProbe(url, data) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const resp = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(data)
            });
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            return resp.json();
        }

        document.getElementById('srcLoadDbsBtn').addEventListener('click', async function () {
            const payload = srcGetProbePayload(false);
            if (!payload.server) { alert('Enter a server address first.'); return; }
            if (!payload.useWindowsAuth && !payload.username) { alert('Enter a username for SQL Server authentication.'); return; }

            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Loading…';
            try {
                const databases = await srcPostProbe('/Servers/ProbeDestinationDatabases', payload);
                const sel = document.getElementById('srcDatabaseSelect');
                const current = document.getElementById('srcDefaultDatabaseHidden').value;
                sel.innerHTML = '<option value="">— select a database —</option>';
                if (!databases.length) {
                    sel.innerHTML = '<option value="">No databases found — check permissions</option>';
                } else {
                    databases.forEach(db => {
                        const opt = document.createElement('option');
                        opt.value = db; opt.textContent = db;
                        if (db === current) opt.selected = true;
                        sel.appendChild(opt);
                    });
                }
            } catch (e) {
                alert('Failed to load databases: ' + e.message);
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Load';
            }
        });

        document.getElementById('srcDatabaseSelect').addEventListener('change', function () {
            document.getElementById('srcDefaultDatabaseHidden').value = this.value;
            document.getElementById('srcTestConnResult').textContent = '';
        });

        document.getElementById('srcTestConnBtn').addEventListener('click', async function () {
            const payload = srcGetProbePayload(true);
            if (!payload.server) { alert('Enter a server address first.'); return; }
            if (!payload.database) { alert('Select a database first.'); return; }

            const result = document.getElementById('srcTestConnResult');
            this.disabled = true;
            result.className = 'ms-2 small text-muted';
            result.textContent = 'Testing…';
            try {
                const data = await srcPostProbe('/Servers/ProbeDestinationConnection', payload);
                result.className = 'ms-2 small ' + (data.ok ? 'text-success' : 'text-danger');
                result.innerHTML = (data.ok
                    ? '<i class="bi bi-check-circle me-1"></i>'
                    : '<i class="bi bi-x-circle me-1"></i>') + data.message;
            } catch (e) {
                result.className = 'ms-2 small text-danger';
                result.textContent = 'Error: ' + e.message;
            } finally {
                this.disabled = false;
            }
        });
        </script>
    }
}
