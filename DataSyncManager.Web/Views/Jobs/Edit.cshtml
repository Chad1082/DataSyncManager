@model JobFormViewModel
@{
    ViewData["Title"] = "Edit Job";
    var isUpsert = Model.SyncMode == SyncMode.Upsert;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Details" asp-controller="Projects" asp-route-id="@Model.ProjectId"
               class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
            <div>
                <h2 class="mb-0">Edit Job</h2>
                <p class="text-muted mb-0">@Model.JobName</p>
            </div>
        </div>

        <form asp-action="Edit" method="post" id="jobForm">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ProjectId" />
            <input type="hidden" asp-for="SourceServerId" />
            <input type="hidden" asp-for="SortOrder" />          @* ← add this *@
            <input type="hidden" asp-for="IsActive" />           @* ← and probably this — see note *@
            <input type="hidden" id="selectedFieldsJson" name="SelectedFieldsJson" value="@Model.SelectedFieldsJson" />

            <!-- Source -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-table me-2"></i>Source</div>
                <div class="card-body row g-3">

                    @if (Model.ProjectSourceServer?.SourceType != DataSyncManager.Web.Models.SourceType.RestApi)
                    {
                        <div class="col-12">
                            <label class="form-label fw-semibold">Source Mode</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="sourceMode" id="modeTable"
                                           value="table" @(Model.IsCustomQuery ? "" : "checked")>
                                    <label class="form-check-label" for="modeTable">Table</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="sourceMode" id="modeQuery"
                                           value="query" @(Model.IsCustomQuery ? "checked" : "")>
                                    <label class="form-check-label" for="modeQuery">Custom SQL Query</label>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Table display panel (read-only on edit) -->
                    <div id="tableModePanel" class="col-md-5" style="@(Model.IsCustomQuery ? "display:none" : "")">
                        <label class="form-label fw-semibold">Source Table</label>
                        <input class="form-control" value="@Model.SourceTable" readonly />
                        <input type="hidden" asp-for="SourceTable" />
                        <div class="form-text">Source table cannot be changed. Create a new job to use a different table.</div>
                    </div>

                    <!-- Custom query panel -->
                    <div id="queryModePanel" class="col-12" style="@(!Model.IsCustomQuery ? "display:none" : "")">
                        <div class="mb-2">
                            <label asp-for="SourceQuery" class="form-label fw-semibold">SELECT Statement *</label>
                            <textarea asp-for="SourceQuery" class="form-control font-monospace" rows="5" maxlength="100000"
                                      placeholder="SELECT col1, col2 FROM dbo.MyTable WHERE IsActive = 1"></textarea>
                            <div class="form-text">
                                Write a full SELECT statement. For Upsert jobs, ensure the <code>ChangeDateField</code> column is included in the results.
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="previewQueryColsBtn">
                            <i class="bi bi-search me-1"></i>Preview Columns
                        </button>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="JobName" class="form-label fw-semibold">Job Name <span class="text-danger">*</span></label>
                        <input asp-for="JobName" class="form-control" />
                        <span asp-validation-for="JobName" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Field selection -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center gap-2">
                    <span class="text-nowrap"><i class="bi bi-list-check me-2"></i>Fields</span>
                    <input type="text" class="form-control form-control-sm" id="fieldsSearch" placeholder="Search fields…" />
                    <div class="d-flex gap-2 flex-shrink-0">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(true)">All</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(false)">None</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadFields()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Reload
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="fieldsLoading" class="text-center py-3 text-muted d-none">
                        <div class="spinner-border spinner-border-sm me-2"></div>Loading fields...
                    </div>
                    <div id="fieldsContainer"></div>
                    <div id="fieldsEmpty" class="text-muted text-center py-3 d-none">
                        No fields loaded. Click Reload.
                    </div>
                </div>
            </div>

            <!-- Sync mode -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-arrow-left-right me-2"></i>Sync Mode</div>
                <div class="card-body">
                    <div class="d-flex gap-4 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="SyncMode" id="modeReplace"
                                   value="FullReplace" @(!isUpsert ? "checked" : "")>
                            <label class="form-check-label fw-semibold" for="modeReplace">Full Replace</label>
                            <div class="text-muted small">Truncate destination then bulk insert all rows.</div>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="SyncMode" id="modeUpsert"
                                   value="Upsert" @(isUpsert ? "checked" : "")>
                            <label class="form-check-label fw-semibold" for="modeUpsert">Upsert</label>
                            <div class="text-muted small">Insert new rows and update changed rows.</div>
                        </div>
                    </div>

                    <div id="upsertPanel" class="@(!isUpsert ? "d-none" : "") border rounded p-3 bg-light">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="SyncStartDate" class="form-label fw-semibold">Sync Start Date</label>
                                <input asp-for="SyncStartDate" type="date" class="form-control"
                                       value="@(Model.SyncStartDate.HasValue ? Model.SyncStartDate.Value.ToString("yyyy-MM-dd") : "")" />
                                <div class="form-text">Used on the first run only. Subsequent runs continue from the last run's timestamp.</div>
                                <span asp-validation-for="SyncStartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Unique Key Fields</label>
                                <input type="text" class="form-control form-control-sm mb-1" id="uniqueKeySearch" placeholder="Search fields…" />
                                <select id="uniqueKeySelect" class="form-select" multiple size="4">
                                    <option disabled class="text-muted fst-italic">Load fields first</option>
                                </select>
                                <input asp-for="UniqueKeyFields" type="hidden" />
                                <div class="form-text">Hold <kbd>Ctrl</kbd> / <kbd>Cmd</kbd> to select multiple. Uniquely identifies a row.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Change Date Field</label>
                                <input type="text" class="form-control form-control-sm mb-1" id="changeDateSearch" placeholder="Search fields…" />
                                <select id="changeDateSelect" class="form-select">
                                    <option value="">— Load fields first —</option>
                                </select>
                                <input asp-for="ChangeDateField" type="hidden" />
                                <div class="form-text">Field used to detect changed rows.</div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="DaysPerBatch" class="form-label fw-semibold">Days Per Batch</label>
                                <input asp-for="DaysPerBatch" class="form-control" type="number"
                                       min="0.04" max="31" step="0.01" />
                                <div class="form-text">0.04 = ~1 hour. Max 31.</div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="SyncOverlapMinutes" class="form-label fw-semibold">Overlap Buffer (min)</label>
                                <input asp-for="SyncOverlapMinutes" class="form-control" type="number" min="0" max="1440" step="1" />
                                <div class="form-text">
                                    Minutes subtracted from the previous run's completion time to set the window start.
                                    Guards against source clock skew and in-flight writes. Default: 5.
                                </div>
                                <span asp-validation-for="SyncOverlapMinutes" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Destination -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-database me-2"></i>Destination</div>
                <div class="card-body row g-3">
                    <div class="col-md-5">
                        <label asp-for="DestinationServerId" class="form-label fw-semibold">Destination Server</label>
                        <select asp-for="DestinationServerId" asp-items="Model.AvailableDestinationServers"
                                class="form-select" id="destServerSelect">
                            <option value="">-- Select Server --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Database</label>
                        <div id="destDatabaseDisplay" class="form-control-plaintext fw-semibold text-primary ps-1">
                            @(string.IsNullOrEmpty(Model.DestinationDatabase) ? "— select a server —" : Model.DestinationDatabase)
                        </div>
                        <input asp-for="DestinationDatabase" type="hidden" id="destDatabaseHidden" />
                        <div class="form-text">Set on the destination server configuration.</div>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="DestinationTable" class="form-label fw-semibold">Destination Table</label>
                        <input asp-for="DestinationTable" class="form-control" />
                        <div class="form-text">Table will be created or altered automatically.</div>
                    </div>
                </div>
            </div>

            <!-- Alerts -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-bell me-2"></i>Job Alerts</div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Alert on</label>
                        <div class="d-flex gap-3">
                            <input asp-for="AlertOnSuccess" class="form-check-input" id="jAlertSuccess" />
                            <label class="form-check-label" for="jAlertSuccess">Success</label>

                            <input asp-for="AlertOnFailure" class="form-check-input" id="jAlertFailure" />
                            <label class="form-check-label" for="jAlertFailure">Failure</label>

                            <input asp-for="AlertOnError" class="form-check-input" id="jAlertError" />
                            <label class="form-check-label" for="jAlertError">Errors</label>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="AlertEmailAddresses" class="form-label fw-semibold">Alert Email Addresses</label>
                        <input asp-for="AlertEmailAddresses" class="form-control"
                               placeholder="ops@example.com, team@example.com" />
                        <div class="form-text">Comma-separated. Overrides project-level alert addresses.</div>
                    </div>
                </div>
            </div>

            <!-- SQL Preview -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-code-square me-2 text-primary"></i>SQL Preview</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="buildSqlPreview()">
                        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-lg-6 border-end">
                            <div class="px-3 pt-3 pb-1">
                                <span class="badge bg-secondary mb-2"><i class="bi bi-database-up me-1"></i>Source Query</span>
                            </div>
                            <pre id="sqlSource" class="m-0 px-3 pb-3 small" style="background:transparent;white-space:pre-wrap;word-break:break-all;min-height:120px;color:#0d6efd;font-family:monospace;">Loading...</pre>
                        </div>
                        <div class="col-lg-6">
                            <div class="px-3 pt-3 pb-1">
                                <span class="badge bg-secondary mb-2"><i class="bi bi-database-down me-1"></i>Destination Operation</span>
                            </div>
                            <pre id="sqlDest" class="m-0 px-3 pb-3 small" style="background:transparent;white-space:pre-wrap;word-break:break-all;min-height:120px;color:#0d6efd;font-family:monospace;">Loading...</pre>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Details" asp-controller="Projects" asp-route-id="@Model.ProjectId"
                   class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    const sourceServerId = '@Model.SourceServerId';
    const sourceTable    = '@Model.SourceTable';
    let savedFields = [];
    let allColOptions = [];
    let selectedUniqueKeys = new Set(
        (document.getElementById('UniqueKeyFields').value || '').split(',').map(s => s.trim()).filter(Boolean)
    );
    let selectedChangeDate = document.getElementById('ChangeDateField').value || '';
    const destDatabases = { @Html.Raw(string.Join(",", Model.AvailableDestinations.Select(d => $"{d.Id}:'{d.DefaultDatabase ?? ""}'"))) };

    // ── Source mode toggle ────────────────────────────

    document.querySelectorAll('input[name="sourceMode"]').forEach(radio => {
        radio.addEventListener('change', function () {
            const isQuery = this.value === 'query';
            document.getElementById('tableModePanel').style.display = isQuery ? 'none' : '';
            document.getElementById('queryModePanel').style.display = isQuery ? '' : 'none';
        });
    });

    // ── Preview columns from custom query ─────────────

            document.getElementById('previewQueryColsBtn')?.addEventListener('click', async function () {
            const query = document.querySelector('[name="SourceQuery"]').value.trim();
            if (!query) { alert('Enter a SELECT statement first.'); return; }

            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Loading…';

            try {
                const resp = await fetch('/Servers/GetColumnsFromQuery?serverId=' + sourceServerId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(query)
                });

                const text = await resp.text();

                if (!resp.ok) {
                    alert('Query error: ' + text);
                    return;
                }

                let cols;
                try {
                    cols = JSON.parse(text.replace(/^\uFEFF/, '').trim());
                } catch (parseErr) {
                    alert('Parse failed. First 500 chars:\n' + text.substring(0, 500));
                    return;
                }

                renderFields(cols);
                buildSqlPreview();
            } catch (e) {
                alert('Request failed: ' + e.message);
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-search me-1"></i>Preview Columns';
            }
        });

    document.getElementById('destServerSelect').addEventListener('change', function () {
        const db = destDatabases[this.value] || '';
        document.getElementById('destDatabaseHidden').value = db;
        document.getElementById('destDatabaseDisplay').textContent = db || '— no default database configured —';
        buildSqlPreview();
    });

    try {
        const raw = document.getElementById('selectedFieldsJson').value;
        if (raw) savedFields = JSON.parse(raw);
    } catch(e) { savedFields = []; }

    async function loadFields() {
        document.getElementById('fieldsLoading').classList.remove('d-none');
        document.getElementById('fieldsContainer').innerHTML = '';
        document.getElementById('fieldsEmpty').classList.add('d-none');

        const isQueryMode = document.getElementById('modeQuery')?.checked;

        try {
            let cols;
            if (isQueryMode) {
                const query = document.querySelector('[name="SourceQuery"]')?.value?.trim();
                if (!query) {
                    document.getElementById('fieldsEmpty').classList.remove('d-none');
                    document.getElementById('fieldsEmpty').textContent = 'Enter a SELECT statement and click Preview Columns.';
                    return;
                }
                const resp = await fetch('/Servers/GetColumnsFromQuery?serverId=' + sourceServerId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(query)
                });
                if (!resp.ok) throw new Error(await resp.text());
                cols = await resp.json();
            } else {
                const resp = await fetch(`/Servers/GetSourceColumns?serverId=${sourceServerId}&tableName=${encodeURIComponent(sourceTable)}`);
                cols = await resp.json();
            }
            renderFields(cols);
        } catch(e) {
            document.getElementById('fieldsEmpty').classList.remove('d-none');
            document.getElementById('fieldsEmpty').textContent = 'Failed to load fields: ' + e.message;
        } finally {
            document.getElementById('fieldsLoading').classList.add('d-none');
        }
    }

    function renderFields(cols) {
        const container = document.getElementById('fieldsContainer');
        if (!cols || !cols.length) {
            document.getElementById('fieldsEmpty').classList.remove('d-none');
            return;
        }
        const savedMap = {};
        savedFields.forEach(f => savedMap[f.sourceFieldName] = f);

        const table = document.createElement('table');
        table.className = 'table table-sm table-hover align-middle mb-0';
        table.innerHTML = `<thead class="table-light"><tr>
            <th style="width:40px"></th><th>Source Field</th><th>Destination Field</th>
            <th>Data Type</th><th>Max Length</th><th>Nullable</th></tr></thead>`;
        const tbody = document.createElement('tbody');
        cols.forEach(col => {
            const saved = savedMap[col.name] || {};
            const included = saved.isIncluded !== undefined ? saved.isIncluded : savedFields.length === 0;
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><input type="checkbox" class="form-check-input field-check"
                    data-field="${col.name}" ${included ? 'checked' : ''}></td>
                <td class="fw-semibold text-truncate" style="max-width:160px" title="${col.name}">${col.name}</td>
                <td><input type="text" class="form-control form-control-sm dest-name"
                    value="${saved.destinationFieldName || col.name}" style="min-width:120px"></td>
                <td><span class="badge bg-light text-dark border">${col.dataType || ''}</span></td>
                <td>${col.maxLength != null ? col.maxLength : ''}</td>
                <td>${col.isNullable ? '<i class="bi bi-check text-success"></i>' : ''}</td>`;
            tbody.appendChild(tr);
        });
        table.appendChild(tbody);
        container.appendChild(table);

        // Populate UniqueKey and ChangeDate selects
        allColOptions = cols;
        selectedUniqueKeys = new Set(
            (document.getElementById('UniqueKeyFields').value || '').split(',').map(s => s.trim()).filter(Boolean)
        );
        selectedChangeDate = document.getElementById('ChangeDateField').value || '';
        document.getElementById('uniqueKeySearch').value = '';
        document.getElementById('changeDateSearch').value = '';
        renderUniqueKeyOptions('');
        renderChangeDateOptions('');

        // Re-apply fields search if active
        const fq = (document.getElementById('fieldsSearch').value || '').toLowerCase();
        if (fq) {
            container.querySelectorAll('tbody tr').forEach(row => {
                const name = (row.querySelector('.field-check')?.dataset.field || '').toLowerCase();
                row.style.display = (!fq || name.includes(fq)) ? '' : 'none';
            });
        }
    }

    function selectAll(val) {
        document.querySelectorAll('.field-check').forEach(c => c.checked = val);
    }

    function renderUniqueKeyOptions(query) {
        const sel = document.getElementById('uniqueKeySelect');
        sel.innerHTML = '';
        allColOptions.filter(c => !query || c.name.toLowerCase().includes(query)).forEach(col => {
            const o = document.createElement('option');
            o.value = col.name; o.textContent = col.name;
            o.selected = selectedUniqueKeys.has(col.name);
            sel.appendChild(o);
        });
    }

    function renderChangeDateOptions(query) {
        const sel = document.getElementById('changeDateSelect');
        sel.innerHTML = '<option value="">— none —</option>';
        allColOptions.filter(c => !query || c.name.toLowerCase().includes(query)).forEach(col => {
            const o = document.createElement('option');
            o.value = col.name; o.textContent = `${col.name}  (${col.dataType})`;
            o.selected = col.name === selectedChangeDate;
            sel.appendChild(o);
        });
    }

    document.getElementById('jobForm').addEventListener('submit', function() {
        // If in query mode, stamp SourceTable with sentinel so it round-trips correctly
        if (document.getElementById('modeQuery')?.checked) {
            const hiddenSrc = document.querySelector('input[name="SourceTable"][type="hidden"]');
            if (hiddenSrc) hiddenSrc.value = '(Custom Query)';
        }

        const rows = document.querySelectorAll('.field-check');
        if (!rows.length) return;
        const fields = [];
        rows.forEach(chk => {
            const row = chk.closest('tr');
            const destInput = row.querySelector('.dest-name');
            fields.push({
                sourceFieldName: chk.dataset.field,
                destinationFieldName: destInput ? destInput.value : chk.dataset.field,
                isIncluded: chk.checked
            });
        });
        document.getElementById('selectedFieldsJson').value = JSON.stringify(fields);
        document.getElementById('UniqueKeyFields').value = [...selectedUniqueKeys].join(', ');
        document.getElementById('ChangeDateField').value = selectedChangeDate;
    });

    document.querySelectorAll('input[name="SyncMode"]').forEach(r => {
        r.addEventListener('change', function() {
            document.getElementById('upsertPanel').classList.toggle('d-none', this.value !== 'Upsert');
        });
    });

    // ── SQL Preview ────────────────────────────────
    function buildSqlPreview() {
        const sourceTable     = '@Model.SourceTable';
        const syncMode        = document.querySelector('input[name="SyncMode"]:checked')?.value || 'Upsert';
        const fieldChecks     = [...document.querySelectorAll('.field-check:checked')];
        const fields          = fieldChecks.map(cb => {
            const row = cb.closest('tr');
            return row?.querySelector('.dest-name')?.value?.trim() || cb.dataset.field;
        }).filter(Boolean);
        const destTable       = (document.getElementById('DestinationTable').value || '').trim();
        const uniqueKeysRaw   = (document.getElementById('UniqueKeyFields').value || '');
        const uniqueKeys      = uniqueKeysRaw.split(',').map(k => k.trim()).filter(Boolean);
        const changeDateField = (document.getElementById('ChangeDateField').value || '').trim();
        const daysPerBatch    = parseFloat(document.getElementById('DaysPerBatch').value) || 1;
        const syncStartDateEl = document.querySelector('[name="SyncStartDate"]');
        const syncStartDate   = syncStartDateEl?.value;

        const destParts  = destTable ? destTable.split('.') : [];
        const destSchema = destParts.length === 2 ? destParts[0] : 'dbo';
        const destTbl    = destParts.length === 2 ? destParts[1] : (destTable || null);

        // ── Source query ──────────────────────────
        let sourceSql;
        if (!fields.length) {
            sourceSql = '-- Fields are still loading...';
        } else {
            const cols = fields.map(f => '    [' + f + ']').join(',\n');
            sourceSql = 'SELECT\n' + cols + '\nFROM ' + sourceTable;
            if (syncMode === 'Upsert' && changeDateField) {
                const startDt = syncStartDate
                    ? new Date(syncStartDate + 'T00:00:00Z')
                    : new Date(Date.now() - daysPerBatch * 86400000);
                const endDt = new Date(startDt.getTime() + daysPerBatch * 86400000);
                const fmt = d => d.toISOString().slice(0, 19).replace('T', ' ');
                sourceSql += '\nWHERE [' + changeDateField + '] >= \'' + fmt(startDt) + '\''
                           + '\n  AND [' + changeDateField + '] <  \'' + fmt(endDt) + '\'';
                sourceSql += '\n\n-- Repeated in ' + daysPerBatch + ' day window(s) up to current date';
            }
        }

        // ── Destination operation ─────────────────
        let destSql;
        if (!destTbl) {
            destSql = '-- Enter a destination table above';
        } else if (syncMode === 'FullReplace') {
            destSql = '-- Step 1: clear existing data\nTRUNCATE TABLE [' + destSchema + '].[' + destTbl + '];\n\n'
                    + '-- Step 2: bulk insert all source rows\n-- (SqlBulkCopy → [' + destSchema + '].[' + destTbl + '])';
        } else {
            if (!fields.length) {
                destSql = '-- Fields are still loading...';
            } else if (!uniqueKeys.length) {
                destSql = '-- Enter Unique Key Fields above to preview the MERGE statement';
            } else {
                const onClause  = uniqueKeys.map(k => '    t.[' + k + '] = s.[' + k + ']').join('\n    AND ');
                const nonKeys   = fields.filter(f => !uniqueKeys.includes(f));
                const setClause = (nonKeys.length
                    ? nonKeys.map(f => '    t.[' + f + '] = s.[' + f + ']').join(',\n') + ',\n'
                    : '') + '    t.[_SyncedAt] = GETUTCDATE()';
                const insCols = fields.map(f => '[' + f + ']').join(', ') + ', [_SyncedAt]';
                const insVals = fields.map(f => 's.[' + f + ']').join(', ') + ', GETUTCDATE()';

                destSql = '-- Step 1: bulk insert into temp staging table\n-- (SqlBulkCopy → #staging)\n\n'
                    + '-- Step 2: merge staging into destination\n'
                    + 'MERGE [' + destSchema + '].[' + destTbl + '] AS t\n'
                    + 'USING #staging AS s ON (\n' + onClause + '\n)\n'
                    + 'WHEN MATCHED THEN\n    UPDATE SET\n' + setClause + '\n'
                    + 'WHEN NOT MATCHED BY TARGET THEN\n'
                    + '    INSERT (' + insCols + ')\n'
                    + '    VALUES (' + insVals + ')\n'
                    + 'OUTPUT $action;';
            }
        }

        document.getElementById('sqlSource').textContent = sourceSql;
        document.getElementById('sqlDest').textContent   = destSql;
    }

    // Re-run after fields load
    const _origLoadFields = loadFields;
    loadFields = async function() {
        await _origLoadFields();
        buildSqlPreview();
    };

    // Hook all inputs that affect the preview
    document.querySelectorAll('input[name="SyncMode"]').forEach(r => r.addEventListener('change', buildSqlPreview));
    document.getElementById('DestinationTable').addEventListener('input', buildSqlPreview);
    document.getElementById('uniqueKeySelect').addEventListener('change', function() {
        [...this.options].forEach(o => {
            if (o.selected) selectedUniqueKeys.add(o.value);
            else selectedUniqueKeys.delete(o.value);
        });
        document.getElementById('UniqueKeyFields').value = [...selectedUniqueKeys].join(', ');
        buildSqlPreview();
    });
    document.getElementById('changeDateSelect').addEventListener('change', function() {
        selectedChangeDate = this.value;
        document.getElementById('ChangeDateField').value = this.value;
        buildSqlPreview();
    });
    document.getElementById('fieldsSearch').addEventListener('input', function() {
        const q = this.value.toLowerCase();
        document.querySelectorAll('#fieldsContainer tbody tr').forEach(row => {
            const name = (row.querySelector('.field-check')?.dataset.field || '').toLowerCase();
            row.style.display = (!q || name.includes(q)) ? '' : 'none';
        });
    });
    document.getElementById('uniqueKeySearch').addEventListener('input', function() {
        renderUniqueKeyOptions(this.value.toLowerCase());
    });
    document.getElementById('changeDateSearch').addEventListener('input', function() {
        renderChangeDateOptions(this.value.toLowerCase());
    });
    document.getElementById('DaysPerBatch').addEventListener('input', buildSqlPreview);
    document.getElementById('fieldsContainer').addEventListener('change', buildSqlPreview);
    document.querySelector('[name="SyncStartDate"]')?.addEventListener('change', buildSqlPreview);

    // Load fields on page load
    loadFields();
    </script>
}
