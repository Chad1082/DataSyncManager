@model DataSyncManager.Web.ViewModels.JobFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Job" : "New Job";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index">Projects</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.ProjectName</a>
            </li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <small class="text-muted">Source server: <strong>@Model.ProjectSourceServer?.Name</strong> (@Model.ProjectSourceServer?.SourceType)</small>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post" id="jobForm">
    @Html.AntiForgeryToken()
    <input asp-for="ProjectId" type="hidden" />
    <input asp-for="ProjectName" type="hidden" />
    <input asp-for="SelectedFieldsJson" type="hidden" id="selectedFieldsJson" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="row g-4">
        <!-- LEFT: Config -->
        <div class="col-lg-7">

            <!-- General -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">General</h6>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Job Name *</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="SortOrder" class="form-label fw-semibold">Sort Order</label>
                            <input asp-for="SortOrder" type="number" class="form-control" min="0" />
                        </div>
                        <div class="col-sm-6 mb-3 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Source -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">Source</h6>

                    @if (Model.ProjectSourceServer?.SourceType != DataSyncManager.Web.Models.SourceType.RestApi)
                    {
                        <!-- Source Mode toggle (SQL Server / ODBC only) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Source Mode</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="sourceMode" id="modeTable"
                                           value="table" @(Model.IsCustomQuery ? "" : "checked")>
                                    <label class="form-check-label" for="modeTable">Table</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="sourceMode" id="modeQuery"
                                           value="query" @(Model.IsCustomQuery ? "checked" : "")>
                                    <label class="form-check-label" for="modeQuery">Custom SQL Query</label>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Table selector panel -->
                    <div id="tableModePanel" style="@(Model.IsCustomQuery ? "display:none" : "")">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Source Table / Endpoint *</label>
                            <input type="text" class="form-control form-control-sm mb-1" id="sourceTableSearch" placeholder="Search tables…" />
                            <div class="input-group">
                                <select id="sourceTableSelect" class="form-select">
                                    <option value="">— loading tables… —</option>
                                </select>
                                <input asp-for="SourceTable" type="hidden" id="sourceTableHidden" />
                                <button type="button" class="btn btn-outline-secondary" id="loadTablesBtn">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            <span asp-validation-for="SourceTable" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Custom query panel -->
                    <div id="queryModePanel" style="@(!Model.IsCustomQuery ? "display:none" : "")">
                        <div class="mb-2">
                            <label asp-for="SourceQuery" class="form-label fw-semibold">SELECT Statement *</label>
                            <textarea asp-for="SourceQuery" class="form-control font-monospace" rows="5" maxlength="100000"
                                      placeholder="SELECT col1, col2 FROM dbo.MyTable WHERE IsActive = 1"></textarea>
                            <div class="form-text">
                                Write a full SELECT statement. For Upsert jobs, ensure the <code>ChangeDateField</code> column is included in the results.
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="previewQueryColsBtn">
                            <i class="bi bi-search me-1"></i>Preview Columns
                        </button>
                    </div>

                </div>
            </div>

            <!-- Destination -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">Destination</h6>
                    <div class="mb-3">
                        <label asp-for="DestinationServerId" class="form-label fw-semibold">Destination Server *</label>
                        <select asp-for="DestinationServerId" class="form-select" id="destServerSelect"
                                asp-items="@(new SelectList(Model.AvailableDestinations, "Id", "Name"))">
                            <option value="">— select —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Database</label>
                        <div id="destDatabaseDisplay" class="form-control-plaintext fw-semibold text-primary ps-1">
                            @(string.IsNullOrEmpty(Model.DestinationDatabase) ? "— select a server —" : Model.DestinationDatabase)
                        </div>
                        <input asp-for="DestinationDatabase" type="hidden" id="destDatabaseHidden" />
                        <div class="form-text">Set on the destination server configuration.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Destination Table *</label>
                        <div class="input-group">
                            <select id="destTableSelect" class="form-select">
                                <option value="__new__">— Create new table —</option>
                            </select>
                            <input asp-for="DestinationTable" type="hidden" id="destTableHidden" />
                            <button type="button" class="btn btn-outline-secondary" id="loadDestTablesBtn">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <input type="text" id="newTableNameInput" class="form-control mt-2"
                               placeholder="New table name (e.g. dbo.MyTable)"
                               value="@Model.DestinationTable" />
                        <span asp-validation-for="DestinationTable" class="text-danger small"></span>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input asp-for="CreateDestinationTableIfMissing" class="form-check-input" type="checkbox" />
                        <label asp-for="CreateDestinationTableIfMissing" class="form-check-label">
                            Create destination table if it doesn't exist
                        </label>
                    </div>
                </div>
            </div>

            <!-- Sync Config -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">Sync Configuration</h6>
                    <div class="mb-3">
                        <label asp-for="SyncMode" class="form-label fw-semibold">Sync Mode *</label>
                        <select asp-for="SyncMode" class="form-select" id="syncModeSelect">
                            <option value="Upsert">Upsert (Insert / Update)</option>
                            <option value="FullReplace">Full Replace (Truncate & Load)</option>
                        </select>
                    </div>
                    <div id="upsertPanel">
                        <div class="mb-3">
                            <label asp-for="SyncStartDate" class="form-label fw-semibold">
                                Sync Start Date <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SyncStartDate" type="date" class="form-control"
                                   id="syncStartDateInput"
                                   value="@(Model.SyncStartDate.HasValue ? Model.SyncStartDate.Value.ToString("yyyy-MM-dd") : "")" />
                            <div class="form-text">
                                The earliest date from which data will be retrieved on the <strong>first run</strong>.
                                Subsequent runs continue automatically from the previous run's timestamp.
                            </div>
                            <span asp-validation-for="SyncStartDate" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Unique Key Fields</label>
                            <input type="text" class="form-control form-control-sm mb-1" id="uniqueKeySearch" placeholder="Search fields…" />
                            <select id="uniqueKeySelect" class="form-select" multiple size="4">
                                <option disabled class="text-muted fst-italic">Load a source table first</option>
                            </select>
                            <input asp-for="UniqueKeyFields" type="hidden" />
                            <small class="text-muted">Hold <kbd>Ctrl</kbd> / <kbd>Cmd</kbd> to select multiple fields. Used to identify unique rows for upsert.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Change Detection Date Field</label>
                            <input type="text" class="form-control form-control-sm mb-1" id="changeDateSearch" placeholder="Search fields…" />
                            <select id="changeDateSelect" class="form-select">
                                <option value="">— Load a source table first —</option>
                            </select>
                            <input asp-for="ChangeDateField" type="hidden" />
                            <small class="text-muted">Field used to detect rows modified since the last run.</small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DaysPerBatch" class="form-label fw-semibold">Days Per Batch</label>
                        <input asp-for="DaysPerBatch" type="number" step="0.01" min="0.04" max="31" class="form-control" />
                        <small class="text-muted">How many days of data to retrieve per run. Use 0.25 for 6 hours, up to 31 for monthly.</small>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SyncOverlapMinutes" class="form-label fw-semibold">Overlap Buffer (min)</label>
                        <input asp-for="SyncOverlapMinutes" class="form-control" type="number" min="0" max="1440" step="1" />
                        <div class="form-text">
                            Minutes subtracted from the previous run's completion time to set the window start.
                            Guards against source clock skew and in-flight writes. Default: 5.
                        </div>
                        <span asp-validation-for="SyncOverlapMinutes" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Alerts -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">Email Alerts</h6>
                    <div class="mb-3">
                        <label asp-for="JobAlertOn" class="form-label fw-semibold">Send alert when</label>
                        <select asp-for="JobAlertOn" class="form-select">
                            <option value="0">Never</option>
                            <option value="1">Succeeded only</option>
                            <option value="2">Failed only</option>
                            <option value="4">Errors / partial only</option>
                            <option value="7">Always</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AlertEmailAddresses" class="form-label fw-semibold">Email Addresses</label>
                        <input asp-for="AlertEmailAddresses" class="form-control" placeholder="user@example.com, other@example.com" />
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT: Field Picker -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm sticky-top" style="top:70px;">
                <div class="card-header bg-transparent fw-semibold d-flex justify-content-between align-items-center gap-2">
                    <span class="text-nowrap"><i class="bi bi-list-columns me-1 text-primary"></i>Fields</span>
                    <input type="text" class="form-control form-control-sm" id="fieldsSearch" placeholder="Search fields…" />
                    <div class="btn-group btn-group-sm flex-shrink-0">
                        <button type="button" class="btn btn-outline-secondary" id="selectAllBtn">All</button>
                        <button type="button" class="btn btn-outline-secondary" id="deselectAllBtn">None</button>
                    </div>
                </div>
                <div class="card-body p-0" style="max-height:60vh; overflow-y:auto;" id="fieldsPanel">
                    <div class="text-center text-muted py-5" id="fieldsPlaceholder">
                        <i class="bi bi-table fs-3 d-block mb-2"></i>
                        Select a source table to load fields
                    </div>
                    <div class="list-group list-group-flush" id="fieldsList"></div>
                </div>
                <div class="card-footer bg-transparent">
                    <small class="text-muted" id="fieldCount">0 fields selected</small>
                </div>
            </div>
        </div>
    </div>

    <!-- SQL Preview -->
    <div class="mt-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-code-square me-2 text-primary"></i>SQL Preview</h6>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="buildSqlPreview()">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    <div class="col-lg-6 border-end">
                        <div class="px-3 pt-3 pb-1">
                            <span class="badge bg-secondary mb-2"><i class="bi bi-database-up me-1"></i>Source Query</span>
                        </div>
                        <pre id="sqlSource" class="m-0 px-3 pb-3 small" style="background:transparent;white-space:pre-wrap;word-break:break-all;min-height:120px;color:#0d6efd;font-family:monospace;">-- Select a source table above</pre>
                    </div>
                    <div class="col-lg-6">
                        <div class="px-3 pt-3 pb-1">
                            <span class="badge bg-secondary mb-2"><i class="bi bi-database-down me-1"></i>Destination Operation</span>
                        </div>
                        <pre id="sqlDest" class="m-0 px-3 pb-3 small" style="background:transparent;white-space:pre-wrap;word-break:break-all;min-height:120px;color:#0d6efd;font-family:monospace;">-- Configure destination above</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Submit -->
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-lg" id="saveBtn">
            <i class="bi bi-save me-1"></i>Save Job
        </button>
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId"
           class="btn btn-outline-secondary btn-lg">Cancel</a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const sourceServerId = @Model.ProjectSourceServer?.Id;
        let selectedFields = @Html.Raw(Model.SelectedFieldsJson ?? "[]");
        let allSourceTables = [];
        let allColOptions = [];
        let selectedUniqueKeys = new Set();
        let selectedChangeDate = '';
        const destDatabases = { @Html.Raw(string.Join(",", Model.AvailableDestinations.Select(d => $"{d.Id}:'{d.DefaultDatabase ?? ""}'"))) };

        // ── Source mode toggle ────────────────────────────

        document.querySelectorAll('input[name="sourceMode"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const isQuery = this.value === 'query';
                document.getElementById('tableModePanel').style.display = isQuery ? 'none' : '';
                document.getElementById('queryModePanel').style.display = isQuery ? '' : 'none';
                if (!isQuery) {
                    document.getElementById('fieldsPlaceholder').style.display = '';
                    document.getElementById('fieldsList').innerHTML = '';
                    document.getElementById('fieldCount').textContent = '0 fields selected';
                }
            });
        });

        // ── Preview columns from custom query ─────────────

        document.getElementById('previewQueryColsBtn')?.addEventListener('click', async function () {
            const query = document.querySelector('[name="SourceQuery"]').value.trim();
            if (!query) { alert('Enter a SELECT statement first.'); return; }

            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Loading…';

            try {
                const resp = await fetch('/Servers/GetColumnsFromQuery?serverId=' + sourceServerId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(query)
                });
                if (!resp.ok) {
                    const err = await resp.json().catch(() => ({ error: resp.statusText }));
                    alert('Query error: ' + (err.error || resp.statusText));
                    return;
                }
                const cols = await resp.json();
                await loadSourceColumns('__query__', cols);
            } catch (e) {
                alert('Failed to preview columns: ' + e.message);
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-search me-1"></i>Preview Columns';
            }
        });

        // ── Source table loading ──────────────────────────

        async function loadSourceTables() {
            const r = await fetch(`/Servers/GetSourceTables?serverId=${sourceServerId}`);
            allSourceTables = await r.json();
            filterSourceTables(document.getElementById('sourceTableSearch').value.toLowerCase());
            if ('@Model.SourceTable' && '@(Model.IsCustomQuery ? "false" : "true")' !== 'false') loadSourceColumns('@Model.SourceTable');
        }

        function filterSourceTables(query) {
            const sel = document.getElementById('sourceTableSelect');
            const current = document.getElementById('sourceTableHidden').value || '@Model.SourceTable';
            sel.innerHTML = '<option value="">— Select table —</option>';
            allSourceTables.filter(t => !query || t.toLowerCase().includes(query)).forEach(t => {
                const opt = document.createElement('option');
                opt.value = t; opt.textContent = t;
                if (t === current) opt.selected = true;
                sel.appendChild(opt);
            });
        }

        async function loadSourceColumns(tableName, preloadedCols) {
            document.getElementById('fieldsPlaceholder').style.display = '';
            document.getElementById('fieldsList').innerHTML = '';
            let cols;
            if (preloadedCols) {
                cols = preloadedCols;
            } else {
                const r = await fetch(`/Servers/GetSourceColumns?serverId=${sourceServerId}&tableName=${encodeURIComponent(tableName)}`);
                cols = await r.json();
            }

            document.getElementById('fieldsPlaceholder').style.display = 'none';
            const list = document.getElementById('fieldsList');

            cols.forEach((col) => {
                const existing = selectedFields.find(f => f.sourceFieldName === col.name);
                const checked = existing ? existing.isIncluded : true;

                list.innerHTML += `
                  <label class="list-group-item list-group-item-action py-2">
                    <div class="d-flex align-items-center gap-2">
                      <input type="checkbox" class="form-check-input field-check" ${checked ? 'checked' : ''}
                             data-name="${col.name}" data-type="${col.dataType}" data-maxlen="${col.maxLength}" data-nullable="${col.isNullable}" />
                      <div class="flex-grow-1">
                        <div class="fw-semibold small">${col.name}</div>
                        <div class="text-muted" style="font-size:.7rem;">${col.dataType}${col.maxLength > 0 ? '(' + col.maxLength + ')' : ''} ${col.isNullable ? 'NULL' : 'NOT NULL'}</div>
                      </div>
                    </div>
                  </label>`;
            });

            document.querySelectorAll('.field-check').forEach(cb =>
                cb.addEventListener('change', updateFieldCount));
            updateFieldCount();

            // ── Populate unique key and change date selects ──
            allColOptions = cols;
            selectedUniqueKeys = new Set(
                document.getElementById('UniqueKeyFields').value.split(',').map(s => s.trim()).filter(Boolean)
            );
            selectedChangeDate = document.getElementById('ChangeDateField').value;
            document.getElementById('uniqueKeySearch').value = '';
            document.getElementById('changeDateSearch').value = '';
            renderUniqueKeyOptions('');
            renderChangeDateOptions('');
        }

        function renderUniqueKeyOptions(query) {
            const sel = document.getElementById('uniqueKeySelect');
            sel.innerHTML = '';
            allColOptions.filter(c => !query || c.name.toLowerCase().includes(query)).forEach(col => {
                const o = document.createElement('option');
                o.value = col.name; o.textContent = col.name;
                o.selected = selectedUniqueKeys.has(col.name);
                sel.appendChild(o);
            });
        }

        function renderChangeDateOptions(query) {
            const sel = document.getElementById('changeDateSelect');
            sel.innerHTML = '<option value="">— none —</option>';
            allColOptions.filter(c => !query || c.name.toLowerCase().includes(query)).forEach(col => {
                const o = document.createElement('option');
                o.value = col.name; o.textContent = `${col.name}  (${col.dataType})`;
                o.selected = col.name === selectedChangeDate;
                sel.appendChild(o);
            });
        }

        function updateFieldCount() {
            const total = document.querySelectorAll('.field-check').length;
            const sel   = document.querySelectorAll('.field-check:checked').length;
            document.getElementById('fieldCount').textContent = `${sel} of ${total} fields selected`;
        }

        document.getElementById('sourceTableSelect').addEventListener('change', function () {
            document.getElementById('sourceTableHidden').value = this.value;
            if (this.value) {
                loadSourceColumns(this.value);
                // Default new table name to source table name if the user hasn't typed one
                const nameInput = document.getElementById('newTableNameInput');
                if (document.getElementById('destTableSelect').value === '__new__' && !nameInput.dataset.userEdited) {
                    nameInput.value = this.value;
                    syncDestTable();
                    buildSqlPreview();
                }
            }
        });

        document.getElementById('loadTablesBtn').addEventListener('click', loadSourceTables);
        document.getElementById('selectAllBtn').addEventListener('click', () => {
            document.querySelectorAll('.field-check').forEach(c => c.checked = true);
            updateFieldCount();
        });
        document.getElementById('deselectAllBtn').addEventListener('click', () => {
            document.querySelectorAll('.field-check').forEach(c => c.checked = false);
            updateFieldCount();
        });

        // ── Destination table loading ─────────────────────

        async function loadDestTables() {
            const serverId = document.getElementById('destServerSelect').value;
            if (!serverId) { alert('Select a destination server first.'); return; }

            const r = await fetch(`/Servers/GetDestinationTables?serverId=${serverId}`);
            const tables = await r.json();
            const sel = document.getElementById('destTableSelect');
            sel.innerHTML = '<option value="__new__">— Create new table —</option>';
            tables.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t; opt.textContent = t;
                if (t === '@Model.DestinationTable') opt.selected = true;
                sel.appendChild(opt);
            });
        }

        document.getElementById('destServerSelect').addEventListener('change', function () {
            const db = destDatabases[this.value] || '';
            document.getElementById('destDatabaseHidden').value = db;
            document.getElementById('destDatabaseDisplay').textContent = db || '— no default database configured —';
            loadDestTables();
        });

        function syncDestTable() {
            const sel = document.getElementById('destTableSelect');
            const isNew = sel.value === '__new__';
            const nameInput = document.getElementById('newTableNameInput');
            nameInput.style.display = isNew ? '' : 'none';
            document.getElementById('destTableHidden').value = isNew ? nameInput.value.trim() : sel.value;
        }

        document.getElementById('destTableSelect').addEventListener('change', function () {
            const nameInput = document.getElementById('newTableNameInput');
            if (this.value === '__new__' && !nameInput.dataset.userEdited) {
                const sourceTable = document.getElementById('sourceTableSelect').value;
                if (sourceTable) {
                    nameInput.value = sourceTable;
                }
            }
            syncDestTable();
            buildSqlPreview();
        });
        document.getElementById('newTableNameInput').addEventListener('input', function () {
            this.dataset.userEdited = this.value ? 'true' : '';
            if (document.getElementById('destTableSelect').value === '__new__') {
                document.getElementById('destTableHidden').value = this.value.trim();
                buildSqlPreview();
            }
        });
        document.getElementById('loadDestTablesBtn').addEventListener('click', loadDestTables);

        // Set initial state — on page load destTableSelect starts at __new__
        syncDestTable();

        // ── Sync mode toggle ──────────────────────────────

        document.getElementById('syncModeSelect').addEventListener('change', function () {
            document.getElementById('upsertPanel').style.display = this.value === 'Upsert' ? '' : 'none';
        });
        const initialMode = document.getElementById('syncModeSelect').value;
        document.getElementById('upsertPanel').style.display = initialMode === 'Upsert' ? '' : 'none';

        // ── Form submit: serialise all values before posting ─

        document.getElementById('jobForm').addEventListener('submit', function (e) {
            // If in query mode, set SourceTable hidden to sentinel value
            const isQueryMode = document.getElementById('modeQuery')?.checked;
            if (isQueryMode) {
                document.getElementById('sourceTableHidden').value = '(Custom Query)';
            }

            // Sync destination table hidden field
            syncDestTable();
            if (!document.getElementById('destTableHidden').value) {
                e.preventDefault();
                document.getElementById('newTableNameInput').focus();
                document.getElementById('newTableNameInput').classList.add('is-invalid');
                return;
            }
            document.getElementById('newTableNameInput').classList.remove('is-invalid');

            // Serialise selected fields
            const fields = [...document.querySelectorAll('.field-check')].map(cb => ({
                sourceFieldName: cb.dataset.name,
                destinationFieldName: cb.dataset.name,
                dataType: cb.dataset.type,
                maxLength: parseInt(cb.dataset.maxlen),
                isNullable: cb.dataset.nullable === 'true',
                isIncluded: cb.checked
            }));
            document.getElementById('selectedFieldsJson').value = JSON.stringify(fields);

            // Source table
            document.getElementById('sourceTableHidden').value = document.getElementById('sourceTableSelect').value;

            // Unique key fields
            document.getElementById('UniqueKeyFields').value = [...selectedUniqueKeys].join(', ');

            // Change detection date field
            document.getElementById('ChangeDateField').value = selectedChangeDate;
        });

        // ── SQL Preview ───────────────────────────────────

        function buildSqlPreview() {
            const syncMode       = document.getElementById('syncModeSelect').value;
            const sourceTable    = document.getElementById('sourceTableSelect').value;
            const fields         = [...document.querySelectorAll('.field-check:checked')].map(cb => cb.dataset.name);
            const destRaw        = document.getElementById('destTableHidden').value ||
                                   (() => { const v = document.getElementById('destTableSelect').value; return v !== '__new__' ? v : ''; })();
            const destDb         = document.getElementById('destDatabaseHidden').value;
            const changeDateField = selectedChangeDate;
            const daysPerBatch   = parseFloat(document.getElementById('DaysPerBatch').value) || 1;
            const syncStartDate  = document.getElementById('syncStartDateInput')?.value;

            const destParts  = destRaw ? destRaw.split('.') : [];
            const destSchema = destParts.length === 2 ? destParts[0] : 'dbo';
            const destTbl    = destParts.length === 2 ? destParts[1] : (destRaw || null);

            // ── Source query ──────────────────────────
            let sourceSql;
            if (!sourceTable) {
                sourceSql = '-- Select a source table above';
            } else if (!fields.length) {
                sourceSql = '-- Select at least one field';
            } else {
                const cols = fields.map(f => '    [' + f + ']').join(',\n');
                sourceSql = 'SELECT\n' + cols + '\nFROM ' + sourceTable;
                if (syncMode === 'Upsert' && changeDateField) {
                    const startDt = syncStartDate
                        ? new Date(syncStartDate + 'T00:00:00Z')
                        : new Date(Date.now() - daysPerBatch * 86400000);
                    const endDt = new Date(startDt.getTime() + daysPerBatch * 86400000);
                    const fmt = d => d.toISOString().slice(0, 19).replace('T', ' ');
                    sourceSql += '\nWHERE [' + changeDateField + '] >= \'' + fmt(startDt) + '\''
                               + '\n  AND [' + changeDateField + '] <  \'' + fmt(endDt) + '\'';
                    sourceSql += '\n\n-- Repeated in ' + daysPerBatch + ' day window(s) up to current date';
                }
            }

            // ── Destination operation ─────────────────
            let destSql;
            if (!destTbl) {
                destSql = '-- Enter a destination table above';
            } else if (syncMode === 'FullReplace') {
                const fullRef = destDb ? '[' + destDb + '].[' + destSchema + '].[' + destTbl + ']'
                                       : '[' + destSchema + '].[' + destTbl + ']';
                destSql = '-- Step 1: clear existing data\nTRUNCATE TABLE ' + fullRef + ';\n\n'
                        + '-- Step 2: bulk insert all source rows\n-- (SqlBulkCopy → ' + fullRef + ')';
            } else {
                const uniqueKeys = [...selectedUniqueKeys];
                if (!fields.length) {
                    destSql = '-- Select fields above';
                } else if (!uniqueKeys.length) {
                    destSql = '-- Select Unique Key Fields above to preview the MERGE statement';
                } else {
                    const onClause  = uniqueKeys.map(k => '    t.[' + k + '] = s.[' + k + ']').join('\n    AND ');
                    const nonKeys   = fields.filter(f => !uniqueKeys.includes(f));
                    const setClause = (nonKeys.length
                        ? nonKeys.map(f => '    t.[' + f + '] = s.[' + f + ']').join(',\n') + ',\n'
                        : '') + '    t.[_SyncedAt] = GETUTCDATE()';
                    const insCols = fields.map(f => '[' + f + ']').join(', ') + ', [_SyncedAt]';
                    const insVals = fields.map(f => 's.[' + f + ']').join(', ') + ', GETUTCDATE()';

                    destSql = '-- Step 1: bulk insert into temp staging table\n-- (SqlBulkCopy → #staging)\n\n'
                        + '-- Step 2: merge staging into destination\n'
                        + 'MERGE [' + destSchema + '].[' + destTbl + '] AS t\n'
                        + 'USING #staging AS s ON (\n' + onClause + '\n)\n'
                        + 'WHEN MATCHED THEN\n    UPDATE SET\n' + setClause + '\n'
                        + 'WHEN NOT MATCHED BY TARGET THEN\n'
                        + '    INSERT (' + insCols + ')\n'
                        + '    VALUES (' + insVals + ')\n'
                        + 'OUTPUT $action;';
                }
            }

            document.getElementById('sqlSource').textContent = sourceSql;
            document.getElementById('sqlDest').textContent   = destSql;
        }

        // Re-run preview after columns load
        const _origLoadSourceColumns = loadSourceColumns;
        loadSourceColumns = async function(t) {
            await _origLoadSourceColumns(t);
            buildSqlPreview();
        };

        // Hook all inputs that affect the preview
        document.getElementById('syncModeSelect').addEventListener('change', buildSqlPreview);
        document.getElementById('DaysPerBatch').addEventListener('input', buildSqlPreview);
        document.getElementById('destDatabaseHidden').addEventListener('change', buildSqlPreview);
        document.getElementById('destServerSelect').addEventListener('change', buildSqlPreview);
        document.getElementById('destTableSelect').addEventListener('change', buildSqlPreview);
        document.getElementById('fieldsList').addEventListener('change', buildSqlPreview);
        document.getElementById('uniqueKeySelect').addEventListener('change', function() {
            [...this.options].forEach(o => {
                if (o.selected) selectedUniqueKeys.add(o.value);
                else selectedUniqueKeys.delete(o.value);
            });
            buildSqlPreview();
        });
        document.getElementById('changeDateSelect').addEventListener('change', function() {
            selectedChangeDate = this.value;
            buildSqlPreview();
        });

        document.getElementById('sourceTableSearch').addEventListener('input', function() {
            filterSourceTables(this.value.toLowerCase());
        });
        document.getElementById('fieldsSearch').addEventListener('input', function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll('#fieldsList .list-group-item').forEach(item => {
                const name = (item.querySelector('[data-name]')?.dataset.name || '').toLowerCase();
                item.style.display = (!q || name.includes(q)) ? '' : 'none';
            });
        });
        document.getElementById('uniqueKeySearch').addEventListener('input', function() {
            renderUniqueKeyOptions(this.value.toLowerCase());
        });
        document.getElementById('changeDateSearch').addEventListener('input', function() {
            renderChangeDateOptions(this.value.toLowerCase());
        });
        document.getElementById('syncStartDateInput')?.addEventListener('change', buildSqlPreview);

        // ── Init ──────────────────────────────────────────
        const _initQueryMode = document.getElementById('modeQuery')?.checked;
        if (!_initQueryMode) {
            loadSourceTables();
        } else {
            // In query mode on load (e.g. edit page re-render after validation failure)
            // Restore fields placeholder text
            document.getElementById('fieldsPlaceholder').querySelector ? null :
                document.getElementById('fieldsPlaceholder').textContent = 'Click Preview Columns to load fields from your query';
        }
    </script>
}